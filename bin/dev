#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PHP_INI_SCAN_DIR="${PHP_INI_SCAN_DIR:-}:$project_dir/php/conf.d"

# Interactive shells usually load NVM automatically; Composer's subprocess may
# not. Load the user's default Node version so Laravel's Vite process can find
# npm even when this script is launched from a non-interactive shell.
if ! command -v npm >/dev/null 2>&1; then
    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    if [[ -s "$NVM_DIR/nvm.sh" ]]; then
        # shellcheck disable=SC1091
        . "$NVM_DIR/nvm.sh" --no-use
        nvm use --silent default >/dev/null 2>&1 || nvm use --silent node >/dev/null 2>&1 || true
    fi
fi

if ! command -v npm >/dev/null 2>&1; then
    printf 'Node.js/npm não encontrados. Instale Node ou configure NVM (versão default).\n' >&2
    exit 127
fi

exec php "$project_dir/artisan" dev
